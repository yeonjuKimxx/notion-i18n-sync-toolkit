# Notion API Key (필수)
# https://www.notion.so/my-integrations 에서 생성
NOTION_API_KEY=secret_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# 통합 데이터베이스 ID (선택사항)
# 모든 도메인을 하나의 DB에서 관리할 때 사용
NOTION_DB_UNIFIED=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# 개별 데이터베이스 ID (선택사항)
# 도메인별로 별도 DB를 사용할 때 설정
NOTION_DB_COMMON=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
NOTION_DB_AUTH=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
NOTION_DB_BUSINESS=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
NOTION_DB_TOURNAMENT=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# 참고:
# - NOTION_API_KEY는 필수입니다
# - NOTION_DB_UNIFIED 또는 개별 DB ID 중 최소 하나는 필요합니다
# - 통합 DB와 개별 DB를 동시에 사용할 수도 있습니다
